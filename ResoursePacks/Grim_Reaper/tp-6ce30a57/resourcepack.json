    },
    {
      "section": "boss-infos",
      "key": "final-name",
      "values": [
        {
          "lang": "*",
          "value": "Grim Reaper"
        }
      ],
      "original": "Mighty Kasparov"
    },
    {
      "section": "boss-infos",
      "key": "final-lore",
      "values": [
        {
          "lang": "*",
          "value": "Bankruptcy. Unpreparedness. Blunders. He's seen it all. This entity collects dead runs as they lose their last piece. He knows every run's fate, and if you meet him, it's already too late."
        }
      ],
      "original": "In his quest for the perfect opponent, he found only emptiness. So he forged shadows, again and again,\nto break his solitude. Yet none ever matched him. Alone, undefeated, he vowed to destroy the world… so that finally, someone might dare to stop him."
    }
  ],
