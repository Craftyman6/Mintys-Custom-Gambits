    {
      "section": "boss-infos",
      "key": "geisha-name",
      "values": [
        {
          "lang": "*",
          "value": "W. D. Gaster"
        }
      ],
      "original": "Judit Polgeisha"
    },
    {
      "section": "boss-infos",
      "key": "geisha-lore",
      "values": [
        {
          "lang": "*",
          "value": "He was shattered across time and space after he fell into his own creation. Now, he haunts the underground as a specter seeking answers and revenge."
        }
      ],
      "original": "Born to win with elegance, to unsettle and destabilize her opponent, she chose to play a different game... and now, her illusions serve only to trap those who venture too close."
    }
  ],
