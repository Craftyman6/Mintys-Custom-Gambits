      "section": "boss-infos",
      "key": "clock-lore",
      "values": [
        {
          "lang": "*",
          "value": "The wickedness of the Majora's Mask has set this moon on a collission course to devour everything and everyone. Consumption is its only goal."
        }
      ],
      "original": "The eternal archive, keeper of all future games. But when he glimpsed his master’s fate, his clock broke, and its hands replay the same destiny forever."
    }
